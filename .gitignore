# Per-run state: logs, pidfiles, the generated media origin configuration and its media output,
# and stored evidence of a run
scripts/*/run/

# Per-machine copy of the provider's service list left by earlier versions of start-all.sh, which
# now saves it under run/ instead and restores it on stop.
backups/

node_modules/
*.log

# Python bytecode cache
__pycache__/
